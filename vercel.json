{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build && node scripts/prepare-vercel-static.mjs",
    "outputDirectory": "vercel-static",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.8.0",
            "regions": ["sin1"],
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "^/_php-health$",
            "dest": "/api/health.php"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
